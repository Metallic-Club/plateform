# HTTP reads work without a key. Creator routes fail closed until configured.
METALLIC_HOST=127.0.0.1
METALLIC_PORT=3000
METALLIC_DATABASE_PATH=./data/catalog.sqlite
NODE_ENV=development
# Generate a unique local secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
