# Copy to .env for local runs. Names only; never commit real values.
# Address the HTTP server binds to. Default 127.0.0.1:8080.
METALLIC_BIND_ADDR=127.0.0.1:8080
# Which role this process runs: api (worker, realtime and matchmaker come later).
METALLIC_ROLE=api
# Required, no default: dev, staging or prod. The server refuses to start without it. dev relaxes address
# checks and allows a random ticket key; prod logs JSON.
METALLIC_ENV=dev
# tracing filter, e.g. info or metallic_platform=debug,tower_http=info
METALLIC_LOG=info
# Seconds before a request is cut off with 408.
METALLIC_REQUEST_TIMEOUT_SECS=10

# ---- database (local cluster: `scripts/dev-postgres.ps1 url` prints the value)
METALLIC_DATABASE_URL=postgres://metallic:<password>@127.0.0.1:54329/metallic
METALLIC_DATABASE_MAX_CONNECTIONS=20
# ---- secrets: generate with `cargo run -- keygen`; never commit real values
METALLIC_HMAC_KEY=<base64, 32 bytes>
METALLIC_DATA_KEY=<base64, 32 bytes>
# Join-ticket Ed25519 keyset: a file path OR base64 of the JSON (not both). Empty in dev = random key + warning.
# See docs/m2-join-tickets.md. The keyset holds a private key: keep it out of git.
METALLIC_TICKET_KEYS_FILE=
METALLIC_TICKET_KEYS=
# Put the client address in join tickets (ip claim). Off by default.
METALLIC_TICKET_BIND_IP=false
# Deprecated shared game-server secret; only used when METALLIC_LEGACY_SERVER_SECRET=true (default false).
METALLIC_LEGACY_SERVER_SECRET=false
METALLIC_SERVER_SECRET=<at least 32 characters, only with the legacy flag>
# ---- web
METALLIC_PUBLIC_WEB_URL=http://localhost:3000
# Extra allowed web origins, comma separated (never *)
METALLIC_CORS_ORIGINS=
# false only for plain-http local development
METALLIC_COOKIE_SECURE=false
# Header with the client address when behind a trusted proxy (empty = socket address). Read only when the TCP peer
# is in METALLIC_TRUSTED_PROXIES; the right-most hop that is not a trusted proxy is the client.
METALLIC_CLIENT_IP_HEADER=
# Proxies allowed to set that header: comma-separated IPs or CIDRs. Required with METALLIC_CLIENT_IP_HEADER.
METALLIC_TRUSTED_PROXIES=
# Accept loopback/private client and host addresses (knock tokens, host edges). Default: true in dev, false elsewhere.
METALLIC_ALLOW_PRIVATE_ADDRESSES=
# Folder for full dev emails (links included); empty = log the kind only
METALLIC_DEV_MAIL_DIR=
# ---- process
METALLIC_WORKER_ID=0
METALLIC_RUN_JOBS=true
METALLIC_MIGRATE_ON_START=true
# Demo password for `seed` (10+ characters); empty = random, printed once
METALLIC_SEED_PASSWORD=
# ---- policy (spec assistant's calls)
METALLIC_VERIFY_WINDOW_DAYS=30
METALLIC_MAX_ACCOUNTS_PER_EMAIL=5
METALLIC_SIGNUPS_PER_IP_FREE=3
METALLIC_SIGNUPS_PER_IP_REVIEW=10
METALLIC_NAME_HOLD_RENAME_DAYS=90
METALLIC_NAME_HOLD_DELETION_DAYS=30
METALLIC_NAME_RELEASE_JITTER_DAYS=7
METALLIC_USERNAME_CHECKS_PER_HOUR=30
METALLIC_PARENTAL_CONSENT_AGE=13
# In-game chat and voice for verified 13+ accounts; off until age assurance exists (lead review required)
METALLIC_GAME_CHAT_ENABLED=false
METALLIC_GAME_VOICE_ENABLED=false
